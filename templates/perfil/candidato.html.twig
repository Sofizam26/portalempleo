{% extends 'base.html.twig' %}

{% block title %}Perfil de candidato{% endblock %}

{% block body %}
<div class="container mt-4">
    <h4 class="mb-4"> {{perfil.nombre}} </h4>
    <div class="card">
        <div class="card-body">
            <p class="card-text"><strong>Ciudad: </strong> {{ perfil.ciudad ?: 'No indicada'}} </p>
            <p class="card-text"><strong>Telefono: </strong> {{ perfil.telefono ?: 'No indicado'}} </p>
            {% if perfil.cvPdf %}
            <p class="card-text"> <strong>Cv: </strong> {{ perfil.cvPdf }} </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}