{% extends 'base.html.twig' %}

{% block title %}Perfil de candidato{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\NavController::component')) }}
    {% set fotoPerfil = perfil.usuario.fotoPerfil is not empty ? asset(perfil.usuario.fotoPerfil) : asset('images/defaultProfile.jpg')%}

    <div class="container mt-4">
        <div class="card">
            <div class="card-header text-center">
                <img src="{{fotoPerfil}}" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover">
                <h3 class="mt-2"> {{perfil.nombre}} </h3>
                <h5 class="mt-2"> {{perfil.titulo}} </h5>
            </div>
            <div class="card-body">
                <p class="card-text"><strong>Descripción: </strong> {{ perfil.descripcion ?: 'No indicada'}} </p>
                <p class="card-text"><strong>Ciudad: </strong> {{ perfil.ciudad ?: 'No indicada'}} </p>
                <p class="card-text"><strong>Teléfono: </strong> {{ perfil.telefono ?: 'No indicado'}} </p>
                {% if perfil.cvPdf %}
                    <div class="mt-3">
                        <strong>CV:</strong>
                        {% if usuarioActual and perfil.usuario.id == usuarioActual.id %}
                            <a href="{{ path('app_verCv', {'id': perfil.id}) }}" target="_blank" class="btn btn-outline-primary btn-sm ms-2">Ver CV</a>
                        {% elseif perfil.cvPublico %}
                            <a href="{{ path('app_verCv', {'id': perfil.id}) }}" target="_blank" class="btn btn-outline-primary btn-sm ms-2">Ver CV</a>
                        {% elseif solicitudCv and solicitudCv.estado == 'aceptada' %}
                            <a href="{{ path('app_verCv', {'id': perfil.id}) }}" target="_blank" class="btn btn-outline-success btn-sm ms-2">Ver CV</a>
                        {% elseif solicitudCv and solicitudCv.estado == 'pendiente' %}
                            <span class="badge bg-warning text-dark ms-2">Solicitud pendiente</span>
                        {% elseif usuarioActual %}
                            <form method="POST" action="{{ path('app_solicitarCv', {'id': perfil.id}) }}" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm ms-2">
                                    Solicitar acceso
                                </button>
                            </form>
                        {% else %}
                            <span class="text-muted ms-2">Inicia sesión para solicitar acceso</span>
                        {% endif %}  
                    </div>  
                {% endif %}
                {% if usuarioActual and usuarioActual.rol != 'candidato' %}
                <a href="{{ path('iniciar_conversacion', {idUsuario: perfil.usuario.id}) }}" class="btn btn-primary btn-sm mt-2">Conversa</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}