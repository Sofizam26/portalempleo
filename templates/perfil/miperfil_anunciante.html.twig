{% extends 'base.html.twig' %}

{% block title %}Mi perfil{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\NavController::component')) }}
<div class="container mt-4">
    <h4> perfil.nombre </h4>
    <div class="card">
        <div class="card-body">
            <p><strong>Ciudad: </strong> {{ perfil.ciudad ?: 'No indicada'}} </p>
            <p><strong>Telefono: </strong> {{ perfil.telefono ?: 'No indicado'}} </p>
        
            {% if perfil.cvPdf %}
                <p class="card-text"> <strong>Cv: </strong> {{ perfil.cvPdf }} </p>
            {% endif%}
        </div>
    </div>
</div>
{% endblock %}