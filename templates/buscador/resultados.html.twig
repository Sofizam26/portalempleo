{% extends 'base.html.twig' %}

{% block title %}Resultados de búsqueda{% endblock %}

{% block body %}
    {{ render(controller('App\\Controller\\NavController::component')) }}

    <div class="container py-4">
        <h1 class="mb-4">Resultados de búsqueda</h1>

        <p class="text-muted mb-4">
            Resultados para: <strong>{{ filtro }}</strong>
        </p>

        <div class="row g-4">
            <div class="col-12">
                <h2 class="h4 mb-3">Candidatos</h2>

                {% if candidatos is empty %}
                    <div class="alert alert-secondary">No hay candidatos que coincidan.</div>
                {% else %}
                    <div class="row g-3">
                        {% for candidato in candidatos %}
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title mb-1">{{ candidato.nombre }}</h5>

                                        <p class="text-muted mb-2">
                                            {{ candidato.titulo ?: 'Sin título' }}
                                        </p>

                                        <p class="card-text">
                                            {{ candidato.descripcion ? candidato.descripcion|slice(0, 140) ~ (candidato.descripcion|length > 140 ? '...' : '') : 'Sin descripción' }}
                                        </p>

                                        <p class="small text-muted mb-0">
                                            {{ candidato.ciudad ?: 'Ciudad no indicada' }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="col-12">
                <h2 class="h4 mb-3">Anunciantes</h2>

                {% if anunciantes is empty %}
                    <div class="alert alert-secondary">No hay anunciantes que coincidan.</div>
                {% else %}
                    <div class="row g-3">
                        {% for anunciante in anunciantes %}
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title mb-1">{{ anunciante.nombreAnunciante }}</h5>

                                        <p class="text-muted mb-2">
                                            {{ anunciante.tipo ?: 'Sin tipo' }}
                                        </p>

                                        <p class="card-text">
                                            {{ anunciante.descripcion ? anunciante.descripcion|slice(0, 140) ~ (anunciante.descripcion|length > 140 ? '...' : '') : 'Sin descripción' }}
                                        </p>

                                        <p class="small text-muted mb-0">
                                            {{ anunciante.ciudad ?: 'Ciudad no indicada' }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="col-12">
                <h2 class="h4 mb-3">Ofertas</h2>

                {% if ofertas is empty %}
                    <div class="alert alert-secondary">No hay ofertas que coincidan.</div>
                {% else %}
                    <div class="row g-3">
                        {% for oferta in ofertas %}
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title mb-1">{{ oferta.titulo }}</h5>

                                        <p class="text-muted mb-2">
                                            {{ oferta.anunciante.nombreAnunciante ?? 'Anunciante no indicado' }}
                                        </p>

                                        <p class="card-text">
                                            {{ oferta.descripcion ? oferta.descripcion|slice(0, 160) ~ (oferta.descripcion|length > 160 ? '...' : '') : 'Sin descripción' }}
                                        </p>

                                        <p class="small text-muted mb-0">
                                            {{ oferta.ciudad ?: 'Ciudad no indicada' }} · {{ oferta.tipoContrato ?: 'Sin contrato' }}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}