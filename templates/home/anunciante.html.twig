{% extends 'base.html.twig' %}

{% block title %}Home anunciante{% endblock %}

{% block body %}
    <h1>Home de anunciante</h1>

    {% for candidato in candidatos %}
        <p>
            <a href="{{ path('app_perfilCandidato', {id: candidato.id}) }}">
                {{ candidato.nombre }}
            </a>
        </p>
    {% else %}
        <p>No hay candidatos.</p>
    {% endfor %}
{% endblock %}