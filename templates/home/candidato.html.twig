{% extends 'base.html.twig' %}

{% block title %}Home candidato{% endblock %}

{% block body %}
{{ render(controller('App\\Controller\\NavController::component')) }}
<div class="container mt-4">
    <h3 class="mb-4">Últimas ofertas</h3>

    {% for oferta in ofertas %}
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-tittle">{{ oferta.titulo }}</h5>
            <hr>
            <p class="card-text">{{ oferta.descripcion|nl2br }}</p>
            <p class="text">Ciudad: {{ oferta.ciudad }}</p>
            <p class="text">Salario: {{ oferta.salario }}</p>
            <p class="text">Tipo de contrato: {{ oferta.tipoContrato }}</p>
            {% if oferta.anunciante is not null %}
                <p class="card-text"> Anunciante: 
                    <a href="{{ path('app_perfilAnunciante', {id: oferta.anunciante.id}) }}">
                    {{ oferta.anunciante.nombreAnunciante }}
                    </a>
                </p>
            {% endif %}
        </div>
    </div>
    {% else %}
        <p>No hay ofertas.</p>
    {% endfor %}
</div>
{% endblock %}