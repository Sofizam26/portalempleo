{% extends 'base.html.twig' %}

{% block body %}
    {{ render(controller('App\\Controller\\NavController::component')) }}
    
    <div class="d-flex flex-column" style="height: 100vh; background-color: #f8f9fa;">
        
        <!-- Header de la conversación -->
        <div class="bg-dark text-white p-3 shadow-sm">
            <div class="container-fluid">
                <h5 class="mb-0">
                    {% if app.user.rol == 'candidato' %}
                        {{ conversacion.anunciante.nombreAnunciante }}
                    {% else %}
                        {{ conversacion.candidato.nombre }}
                    {% endif %}
                </h5>
            </div>
        </div>

        <!-- Área de mensajes -->
        <div class="flex-grow-1 overflow-auto p-3" id="chat-messages">
            {% if mensajes is empty %}
                <div class="alert alert-info text-center mt-5" role="alert">
                    <i class="bi bi-chat-dots"></i> No hay mensajes aún. ¡Inicia la conversación!
                </div>
            {% else %}
                {% for mensaje in mensajes %}
                    {% if mensaje.remitente == app.user.rol %}
                        <!-- Mensaje mío (derecha, claro) -->
                        <div class="d-flex justify-content-end mb-3">
                            <div class="rounded-3 p-3" style="max-width: 70%; word-wrap: break-word; background-color: #e3f2fd; color: #1565c0;">
                                <p class="mb-1">{{ mensaje.mensaje }}</p>
                                <small class="d-flex align-items-center justify-content-end gap-1" style="color: #1565c0;">
                                    {{ mensaje.fechaEnvio|date('H:i') }}
                                    {% if mensaje.leido %}
                                        <i class="bi bi-check2-all" style="color: #00d4ff;"></i>
                                    {% else %}
                                        <i class="bi bi-check2"></i>
                                    {% endif %}
                                </small>
                            </div>
                        </div>
                    {% else %}
                        <!-- Mensaje del otro (izquierda, oscuro) -->
                        <div class="d-flex justify-content-start mb-3">
                            <div class="rounded-3 p-3" style="max-width: 70%; word-wrap: break-word; background-color: #424242; color: #ffffff;">
                                <p class="mb-1">{{ mensaje.mensaje }}</p>
                                <small style="color: #bdbdbd;">
                                    {{ mensaje.fechaEnvio|date('H:i') }}
                                </small>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </div>

        <!-- Área de envío de mensajes -->
        <div class="border-top bg-white p-3">
            <div class="container-fluid">
                <form action="{{ path('enviar_mensaje', { id: conversacion.id }) }}" method="POST" class="d-flex gap-2">
                    <textarea 
                        name="mensaje" 
                        class="form-control rounded-3" 
                        rows="1" 
                        placeholder="Escribe un mensaje..."
                        style="resize: none; max-height: 100px;"
                        required></textarea>
                    <button type="submit" class="btn btn-dark rounded-3">
                        <i class="bi bi-send"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <style>
        #chat-messages::-webkit-scrollbar {
            width: 8px;
        }
        #chat-messages::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        #chat-messages::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }
        #chat-messages::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
    </style>

    <script>
        // Auto-scroll al último mensaje
        document.getElementById('chat-messages').scrollTop = document.getElementById('chat-messages').scrollHeight;
    </script>

{% endblock %}